datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  phone        String?   @unique
  name         String
  passwordHash String
  role         String    @default("CUSTOMER") // SUPER_ADMIN, ADMIN, SUPERVISOR, INVENTORY_MANAGER, ORDER_MANAGER, DELIVERY_MANAGER, CONTENT_MANAGER, DELIVERY_PARTNER, CUSTOMER
  avatar       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses         Address[]
  orders            Order[]
  carts             Cart[]
  wishlists         Wishlist[]
  reviews           Review[]
  couponUsages      CouponUsage[]
  deliveryPartners  DeliveryPartner[]
  auditLogs         AuditLog[]
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   @default("HOME") // HOME, WORK, OTHER
  fullName      String
  phone         String
  houseBuilding String
  street        String
  landmark      String?
  town          String   @default("Civil Lines")
  state         String   @default("Uttar Pradesh")
  pincode       String
  isDefault     Boolean  @default(false)
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]
}

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  image        String?
  displayOrder Int        @default(0)
  parentId     String?
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryHierarchy")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  products Product[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]
}

model Product {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  description       String
  shortDescription  String?
  categoryId        String
  category          Category       @relation(fields: [categoryId], references: [id])
  brandId           String?
  brand             Brand?         @relation(fields: [brandId], references: [id])
  sku               String         @unique
  mrp               Float
  sellingPrice      Float
  taxRate           Float          @default(5.0)
  stock             Int            @default(0)
  lowStockThreshold Int            @default(5)
  maxOrderQty       Int            @default(10)
  weightGrams       Int?
  status            String         @default("ACTIVE") // ACTIVE, DRAFT, OUT_OF_STOCK, ARCHIVED
  isFeatured        Boolean        @default(false)
  isNewArrival      Boolean        @default(false)
  isBestSeller      Boolean        @default(false)
  rating            Float          @default(4.8)
  reviewCount       Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  images                 ProductImage[]
  variants               ProductVariant[]
  orderItems             OrderItem[]
  cartItems              CartItem[]
  wishlistItems          WishlistItem[]
  reviews                Review[]
  inventoryTransactions  InventoryTransaction[]
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  alt          String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
}

model ProductVariant {
  id             String    @id @default(cuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  sku            String    @unique
  price          Float
  mrp            Float
  stock          Int       @default(0)
  attributesJson String?   // e.g. {"color": "Midnight Blue", "size": "L"}
  createdAt      DateTime  @default(now())

  cartItems CartItem[]
  orderItems OrderItem[]
}

model InventoryTransaction {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  type            String   // PURCHASE, SALE_RESERVED, SALE_FULFILLED, RETURN, ADJUSTMENT
  quantity        Int
  balanceAfter    Int
  referenceType   String?  // ORDER, SUPPLIER_PO, MANUAL_AUDIT
  referenceId     String?
  notes           String?
  createdByUserId String?
  createdAt       DateTime @default(now())
}

model Cart {
  id             String     @id @default(cuid())
  userId         String?
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSessionId String?    @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  items CartItem[]
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
}

model DeliveryZone {
  id                    String   @id @default(cuid())
  name                  String
  minDistanceKm         Float    @default(0.0)
  maxDistanceKm         Float
  deliveryFee           Float    @default(0.0)
  freeDeliveryThreshold Float    @default(499.0)
  minOrderAmount        Float    @default(99.0)
  estimatedMinutes      Int      @default(30)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())

  orders Order[]
}

model Coupon {
  id                String   @id @default(cuid())
  code              String   @unique
  description       String?
  discountType      String   @default("FIXED") // FIXED or PERCENTAGE
  discountValue     Float
  minOrderAmount    Float    @default(0.0)
  maxDiscountAmount Float?
  startDate         DateTime @default(now())
  endDate           DateTime?
  usageLimit        Int      @default(1000)
  usageCount        Int      @default(0)
  perUserLimit      Int      @default(1)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  usages CouponUsage[]
}

model CouponUsage {
  id              String   @id @default(cuid())
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  orderId         String
  discountApplied Float
  createdAt       DateTime @default(now())
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique // e.g. #TK-9833
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  addressId      String
  address        Address       @relation(fields: [addressId], references: [id])
  deliveryZoneId String?
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  
  // Status: PENDING_PAYMENT, CONFIRMED, PROCESSING, PACKING, READY_FOR_PICKUP, ASSIGNED, PICKED_UP, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, RETURNED, REFUNDED
  status         String        @default("CONFIRMED")
  subtotal       Float
  discount       Float         @default(0.0)
  deliveryFee    Float         @default(0.0)
  totalAmount    Float
  
  paymentMethod  String        @default("COD") // COD, UPI, CARD, NETBANKING
  paymentStatus  String        @default("PENDING") // PENDING, PAID, FAILED
  deliverySlot   String?       @default("Today, 30-45 mins")
  deliveryOtp    String        // 6-digit verification code e.g. "849201"
  
  pickerName     String?       // E.g. "Dinesh (Station #2)"
  baggingBay     String?       // E.g. "Bay B-04 Bagged"
  notes          String?
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  assignments    DeliveryAssignment[]
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  productName  String
  productImage String?
  quantity     Int
  unitPrice    Float
  totalAmount  Float
}

model OrderStatusHistory {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus  String?
  newStatus       String
  changedByUserId String?
  reason          String?
  createdAt       DateTime @default(now())
}

model DeliveryPartner {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  name            String
  phone           String
  vehicleType     String   @default("Motorcycle") // Motorcycle, Scooter, Bicycle, EV
  vehicleNumber   String   @default("UP-32-AB-1234")
  status          String   @default("ONLINE") // ONLINE, OFFLINE, BUSY
  currentLat      Float?
  currentLng      Float?
  totalDeliveries Int      @default(0)
  rating          Float    @default(4.9)
  isApproved      Boolean  @default(true)
  todayEarnings   Float    @default(0.0)
  createdAt       DateTime @default(now())

  assignments DeliveryAssignment[]
}

model DeliveryAssignment {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partnerId     String
  partner       DeliveryPartner @relation(fields: [partnerId], references: [id])
  assignedAt    DateTime        @default(now())
  acceptedAt    DateTime?
  pickedUpAt    DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  failureReason String?
  codCollected  Boolean         @default(false)
  distanceKm    Float           @default(2.5)
  partnerEarning Float          @default(45.0)
}

model Banner {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  image       String
  ctaText     String?   @default("Shop Now")
  ctaLink     String?   @default("/shop")
  position    String    @default("HERO_SLIDER") // HERO_SLIDER, PROMO_TOP, PROMO_BOTTOM, FLASH_SALE
  active      Boolean   @default(true)
  displayOrder Int      @default(0)
  startDate   DateTime  @default(now())
  endDate     DateTime?
  createdAt   DateTime  @default(now())
}

model Review {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  rating             Int      @default(5)
  reviewText         String
  isVerifiedPurchase Boolean  @default(true)
  isApproved         Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model StoreSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  role        String?
  action      String
  entity      String
  entityId    String?
  changesJson String?
  ipAddress   String?
  createdAt   DateTime @default(now())
}
